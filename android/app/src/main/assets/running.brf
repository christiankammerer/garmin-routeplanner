# Running profile for Route Planner.
#
# The app passes this text to BRouter as `remoteProfile` with every call, so BRouter's own default
# for `v=foot` (hiking-mountain) is never used. Route preferences are on/off parameters, set per
# call through `extraParams` as `name=0|1` (BRouter parses each value as a number).
#
# Access rules follow BRouter's hiking-mountain profile. Way costs prefer paths, tracks and quiet
# streets, and keep motorways and motor roads out.

---context:global

assign validForFoot = 1

# Route preferences (0 = off, 1 = on).
assign low_incline = 0   # %low_incline% | Prefer routes with little climbing | boolean

assign uphillcost     = if low_incline then 60 else 0
assign uphillcutoff   = if low_incline then 1.5 else 3
assign downhillcost   = 0
assign downhillcutoff = 3

---context:way

assign turncost = 0
assign initialcost = switch route=ferry 10000 0

assign issidewalk = sidewalk=left|right|both|yes

assign defaultaccess =
       switch access=
              not or motorroad=yes highway=motorway|motorway_link
              switch or access=private access=no 0 1

assign bikeaccess =
       switch bicycle=
              switch vehicle=
                     defaultaccess
                     switch or vehicle=private vehicle=no 0 1
              not or bicycle=private or bicycle=no bicycle=dismount

assign footaccess =
       or issidewalk
       or and bikeaccess not foot=no|use_sidepath
       or bicycle=dismount
       switch foot= defaultaccess not foot=private|no|use_sidepath

assign accesspenalty = switch footaccess 0 100000

assign waycost =
       if      route=ferry                              then 5.67
       else if highway=                                 then 100000
       else if highway=proposed|abandoned|construction  then 100000
       else if highway=footway|path|track|pedestrian    then 1
       else if highway=cycleway|bridleway               then 1.1
       else if highway=living_street|residential        then 1.2
       else if highway=service                          then 1.3
       else if highway=unclassified|road                then 1.4
       else if highway=steps                            then 2
       else if highway=tertiary|tertiary_link           then if issidewalk then 1.4 else 2
       else if highway=secondary|secondary_link         then if issidewalk then 1.8 else 4
       else if highway=primary|primary_link             then if issidewalk then 2.5 else 8
       else if highway=trunk|trunk_link                 then 15
       else 3

assign costfactor = add accesspenalty waycost

# Way priorities for BRouter's turn hints (as in its stock profiles).

assign isresidentialorliving = or highway=residential|living_street living_street=yes

assign priorityclassifier =
       if      highway=motorway                  then 30
       else if highway=motorway_link             then 29
       else if highway=trunk                     then 28
       else if highway=trunk_link                then 27
       else if highway=primary                   then 26
       else if highway=primary_link              then 25
       else if highway=secondary                 then 24
       else if highway=secondary_link            then 23
       else if highway=tertiary                  then 22
       else if highway=tertiary_link             then 21
       else if highway=unclassified              then 20
       else if isresidentialorliving             then 6
       else if highway=service                   then 6
       else if highway=cycleway                  then 6
       else if highway=track                     then if tracktype=grade1 then 6 else 4
       else if highway=bridleway|road|path|footway then 4
       else if highway=steps                     then 2
       else if highway=pedestrian                then 2
       else 0

assign isroundabout = junction=roundabout
assign islinktype = highway=motorway_link|trunk_link|primary_link|secondary_link|tertiary_link
assign isgoodforcars =
       if greater priorityclassifier 6 then true
       else if or isresidentialorliving highway=service then true
       else if and highway=track tracktype=grade1 then true
       else false

assign classifiermask = add multiply isroundabout 4
                        add multiply islinktype 8
                            multiply isgoodforcars 16

---context:node

assign defaultaccess =
       switch access=
              1
              switch or access=private access=no 0 1

assign footaccess =
       switch foot=
              defaultaccess
              switch or foot=private foot=no 0 1

assign initialcost = switch footaccess 0 1000000
